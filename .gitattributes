* text=auto
*.md text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.c text eol=lf
*.h text eol=lf
*.ps1 text eol=crlf
*.s text eol=crlf
*.epro2 binary
*.zip binary
*.png binary
*.jpg binary
