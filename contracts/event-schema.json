{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[!-~]+$"
        },
        "agent": {
          "enum": [
            "dsh",
            "codex"
          ]
        },
        "producer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[!-~]+$"
        },
        "runtime_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[!-~]+$"
        },
        "runtime_seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "producer_seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "type": {
          "enum": [
            "session_start",
            "turn_start",
            "activity",
            "attention_open",
            "attention_resolve",
            "error",
            "turn_complete",
            "turn_cancelled",
            "session_end"
          ]
        },
        "channel": {
          "enum": [
            "plugin",
            "hook",
            "wrapper",
            "cli"
          ]
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[!-~]+$"
        },
        "instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[!-~]+$"
        },
        "instance_seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "turn_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[!-~]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "turn_seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "attention_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[!-~]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "reason_code": {
          "enum": [
            null,
            "permission",
            "question",
            "turn_failed",
            "turn_blocked",
            "output_limit",
            "user_cancelled",
            "agent_disposed",
            "answered",
            "withdrawn",
            "process_exit"
          ]
        },
        "outcome": {
          "enum": [
            "disposed",
            "normal",
            "abnormal"
          ]
        }
      },
      "required": [
        "schema_version",
        "event_id",
        "agent",
        "producer_id",
        "runtime_id",
        "runtime_seq",
        "producer_seq",
        "type",
        "channel",
        "session_id",
        "instance_id",
        "instance_seq",
        "turn_id",
        "turn_seq",
        "attention_id",
        "occurred_at",
        "reason_code"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "attention_open",
                  "attention_resolve"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "attention_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[!-~]+$"
              },
              "turn_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[!-~]+$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "session_end"
              }
            }
          },
          "then": {
            "required": [
              "outcome"
            ]
          }
        }
      ]
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[!-~]+$"
        },
        "agent": {
          "enum": [
            "dsh",
            "codex"
          ]
        },
        "producer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[!-~]+$"
        },
        "runtime_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[!-~]+$"
        },
        "runtime_seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "producer_seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "type": {
          "const": "runtime_ready"
        },
        "live_instances": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[!-~]+$"
          }
        }
      },
      "required": [
        "schema_version",
        "event_id",
        "agent",
        "producer_id",
        "runtime_id",
        "runtime_seq",
        "producer_seq",
        "type",
        "live_instances"
      ],
      "additionalProperties": false
    }
  ]
}
